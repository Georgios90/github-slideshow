# Server Configuration
PORT=3000
NODE_ENV=development

# Elasticsearch Configuration
# Option 1: Using Cloud ID (Elastic Cloud)
ELASTICSEARCH_CLOUD_ID=your_cloud_id_here
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# Option 2: Using Direct Host URL (Self-hosted)
# ELASTICSEARCH_HOST=https://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_password_here

# Elasticsearch Index Configuration
ELASTICSEARCH_INDEX=your_index_name

# Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: API Security
# API_KEY=your_api_key_for_frontend_authentication

# Optional: Logging
LOG_LEVEL=info

# Optional: CORS
# ALLOWED_ORIGINS=http://localhost:4000,https://yourdomain.com
